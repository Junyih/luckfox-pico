#!/sbin/openrc-run

# Give eth0 a stable MAC that is unique per board.
#
# The Rockchip vendor storage path is not available on this board (no vnvm
# partition, and no vendor storage backend in the defconfig), so the driver
# falls back to a random MAC on every boot. Instead we pick a MAC once on the
# first boot and keep it in the writable rootfs.
#
# Installed in the default runlevel, ordered before networking. It must NOT be
# in the boot runlevel: the root fs is still read-only during boot, so the
# file can only be read there, not created. The MAC itself is baked into the
# rootfs as /etc/eth-mac, so the read path is what runs on every boot.

depend() {
	after devfs procfs sysfs
	before networking
}

MAC_FILE="/etc/eth-mac"

# Locally administered, unicast: first octet 02.
generate_mac() {
	# Prefer the chip's unique OTP id when the device tree exposes it, so the
	# MAC survives a rootfs reflash. Fall back to random on first boot.
	seed=""
	if [ -r /sys/bus/nvmem/devices/rockchip-otp0/nvmem ]; then
		seed=$(hexdump -v -e '1/1 "%02x"' -n 5 \
			/sys/bus/nvmem/devices/rockchip-otp0/nvmem)
	fi

	# Unfused OTP reads as all zeros, which would give every board the same
	# MAC; fall back to random in that case.
	if [ "${#seed}" -ne 10 ] || [ "$seed" = "0000000000" ]; then
		seed=$(hexdump -v -e '1/1 "%02x"' -n 5 /dev/urandom)
	fi

	[ "${#seed}" -eq 10 ] || return 1

	printf '02:%s\n' "$(printf '%s' "$seed" | sed 's/../:&/g' | sed 's/^://')"
}

start() {
	i=0
	while [ ! -e /sys/class/net/eth0 ] && [ "$i" -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e /sys/class/net/eth0 ] || return 0

	if [ -s "$MAC_FILE" ]; then
		mac=$(cat "$MAC_FILE")
	else
		# Best-effort: only works once the root fs is writable. With the file
		# baked into the rootfs this branch is never taken.
		mac=$(generate_mac) || return 0
		echo "$mac" > "$MAC_FILE" 2>/dev/null
	fi

	ip link show eth0 | grep -q "state UP" && ip link set eth0 down
	ip link set eth0 address "$mac"
	ip link set eth0 up
}
