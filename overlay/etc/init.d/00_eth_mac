#!/sbin/openrc-run

# Give eth0 a stable MAC that is unique per board.
#
# The Rockchip vendor storage path is not available on this board (no vnvm
# partition, and no vendor storage backend in the defconfig), so the GMAC
# driver assigns a random MAC at probe time and every boot gets a different
# one. We set the MAC before networking comes up.
#
# Whenever the SoC OTP (efuse) unique id is readable the MAC is derived from
# it: deterministic, unique per chip, and it needs no writable filesystem, so
# it survives a rootfs reflash. Only when the OTP id is missing or unfused do
# we fall back to a random MAC kept in the writable rootfs.
#
# Installed in the default runlevel, ordered before networking. It must NOT be
# in the boot runlevel: eth0 may not exist yet there, so the file would never
# be created.

depend() {
	after devfs procfs sysfs
	before networking
}

MAC_FILE="/etc/eth-mac"

# rv1106 device tree exposes the chip unique id as the otp_id cell:
#   otp_id: id@a { reg = <0x0a 0x10>; }
# rv1103 boards include rv1106.dtsi, so the same node is present there.
OTP_DEVICE="/sys/bus/nvmem/devices/rockchip-otp0/nvmem"
OTP_ID_OFFSET=10
OTP_ID_BYTES=16

is_mac() {
	case "$1" in
		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;;
		*) return 1 ;;
	esac
}

# Locally administered, unicast: first octet 02.
format_mac() {
	printf '02:%s\n' "$(printf '%s' "$1" | sed 's/../:&/g' | sed 's/^://')"
}

# Read the whole otp_id cell. Fails when the OTP is unavailable or completely
# unfused, which carries no per-board entropy.
read_otp_seed() {
	[ -r "$OTP_DEVICE" ] || return 1
	seed=$(hexdump -v -e '1/1 "%02x"' -s "$OTP_ID_OFFSET" -n "$OTP_ID_BYTES" \
		"$OTP_DEVICE" 2>/dev/null)
	[ "${#seed}" -eq $((OTP_ID_BYTES * 2)) ] || return 1
	case "$seed" in
		*[1-9a-f]*) printf '%s\n' "$seed" ;;
		*) return 1 ;;
	esac
}

# Fold the whole id through sha1 so a difference anywhere in the cell changes
# the MAC, not just the factory lot code at the start of the cell.
otp_mac() {
	seed=$(read_otp_seed) || return 1
	seed=$(printf '%s' "$seed" | sha1sum | cut -c1-10)
	[ "${#seed}" -eq 10 ] || return 1
	format_mac "$seed"
}

random_mac() {
	seed=$(hexdump -v -e '1/1 "%02x"' -n 5 /dev/urandom 2>/dev/null)
	[ "${#seed}" -eq 10 ] || return 1
	format_mac "$seed"
}

# Atomic write: a half-written file must never be read back as a MAC.
store_mac() {
	if [ -s "$MAC_FILE" ] && [ "$(cat "$MAC_FILE")" = "$1" ]; then
		return 0
	fi
	# The root fs is mounted read-only until ubifs finishes its deferred
	# recovery, so the first boot-time write can fail. Retry once after
	# asking for a read/write remount, like Alpine's own root service does.
	for attempt in 1 2; do
		tmp="$MAC_FILE.tmp"
		if (echo "$1" > "$tmp") 2>/dev/null && mv "$tmp" "$MAC_FILE" 2>/dev/null; then
			return 0
		fi
		rm -f "$tmp" 2>/dev/null
		mount -o remount,rw / 2>/dev/null
	done
	return 1
}

start() {
	# The OTP id is immutable, so it is authoritative: a MAC left in
	# /etc/eth-mac by older firmware is replaced instead of pinning a value
	# that collides with every other board from the same batch.
	mac=$(otp_mac)
	if [ -n "$mac" ]; then
		store_mac "$mac" || echo "eth-mac: could not save $mac to $MAC_FILE" >&2
	else
		stored=""
		if [ -s "$MAC_FILE" ]; then
			stored=$(cat "$MAC_FILE")
		fi
		if is_mac "$stored"; then
			mac="$stored"
		else
			mac=$(random_mac) || return 0
			if store_mac "$mac"; then
				echo "eth-mac: generated $mac (stored in $MAC_FILE)" >&2
			else
				echo "eth-mac: $MAC_FILE not writable, MAC will change next boot" >&2
			fi
		fi
	fi

	i=0
	while [ ! -e /sys/class/net/eth0 ] && [ "$i" -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e /sys/class/net/eth0 ] || return 0

	ip link show eth0 | grep -q "state UP" && ip link set eth0 down
	ip link set eth0 address "$mac"
	ip link set eth0 up
}
